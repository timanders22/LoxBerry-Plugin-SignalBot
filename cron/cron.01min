#!/bin/bash
# Weckt den Bot, falls er nicht laeuft. Das Skript selbst haelt die Verbindung
# zum Ereignisstrom dauerhaft offen und sichert sich mit einer Sperrdatei -
# dieser Aufruf ist also ein Wiederbeleber, kein Taktgeber.
#
# Ueber den Interpreter aufgerufen und NICHT nach /dev/null geschrieben:
# LoxBerry leitet die Ausgabe seiner Cron-Zeile bereits dorthin um, ein
# zweites Mal macht jeden Startfehler unsichtbar. Genau daran ist der
# Hintergrunddienst einer anderen Linie acht Fassungen lang gescheitert.
# Diese Datei sammelt AUSSCHLIESSLICH, was beim Wecken schiefgeht. Das
# Protokoll des Bots ist signalbot.log; das schreibt sg_bot.php selbst, Zeile
# fuer Zeile (oeffnen, schreiben, schliessen) - dort haelt niemand etwas fest.
#
# Bis 0.9.20 hiess sie cron.log, was nach einem allgemeinen Cron-Protokoll
# aussah. Der Name sagt jetzt, was drinsteht.
#
# Bekannte Restluecke, am Geraet gemessen (06.09.2026): der ueberlebende Bot
# (PID 822) erbt die Deskriptoren 1 und 2 auf diese Datei und haelt sie, so
# lange er laeuft. Wird die Ramdisk geleert, schreibt er in einen geloeschten
# Inode. Der naechste Minutenlauf legt die Datei zwar neu an, aber der bereits
# laufende Bot findet nicht mehr hin. Aus der Schale ist das nicht zu
# schliessen - ein laufender Prozess laesst seine Deskriptoren nicht tauschen.
# Betroffen ist nur dieser Nebenkanal, nicht das Protokoll.
# Nie als root (G11, Haertung seit 0.9.30): der Bot und der Haus-Leser legten ihre
# Dateien in /tmp/<ordner> sonst als root an, und der Lauf als loxberry kaeme nicht
# mehr an sie heran. LoxBerry ruft diese Datei als loxberry.
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

[ "$(id -u 2>/dev/null)" = 0 ] && exit 0
LOG=REPLACELBPLOGDIR/signalbot_start.log
# Nicht unbegrenzt wachsen lassen; hier steht nur, was schiefgeht.
if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
    : > "$LOG"
fi
# 0.9.32 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 0.9.31 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
( : >>"$LOG" ) 2>/dev/null || LOG=/dev/null


/usr/bin/php REPLACELBPBINDIR/sg_bot.php >> "$LOG" 2>&1 &

# ---- Befehlsbruecke 1.0.1 (seit 0.9.30): ein Waechterlauf je Minute ----
#
# Die Linie hat keinen PHP-Minutentakt; die Bibliotheksform der Bruecke fuer solche
# Linien ist "befehlsbruecke.php --waechter" (startet den Dienst nach, wenn der Haken
# 'Befehle ueber MQTT annehmen' an ist, und haelt ihn an, wenn nicht; nie waehrend der
# Marke). NICHT aus dem Bot - der Dienst waere sonst Kind des Dauerlaeufers. Seine
# Zeilen stehen ueber die Tabelle in signalbot.log; hier nur, was beim Start scheitert.
/usr/bin/php REPLACELBPBINDIR/befehlsbruecke.php --waechter >/dev/null 2>> "$LOG"

# ---- Haus-Leser (Vorschlag 3, seit 0.9.30) ----
#
# Begleitprozess fuer "status strom" & Co. Ohne den Haken 'Werte anderer Plugins im
# Chat abfragen' endet er sofort und still; laeuft er schon, endet der Aufruf an seiner
# Sperre. Eigener Prozess, nicht Kind des Bots.
/usr/bin/php REPLACELBPBINDIR/sg_haus.php >> "$LOG" 2>&1 &
