#!/bin/bash
# Laeuft als ROOT beim Entfernen des Plugins.
ARGV3=$3
ARGV5=$5

echo "<INFO> Halte den Dienst an und entferne ihn"
systemctl disable --now signal-cli-loxberry >/dev/null 2>&1
rm -f /etc/systemd/system/signal-cli-loxberry.service
systemctl daemon-reload >/dev/null 2>&1
rm -f /etc/sudoers.d/loxberry-signalbot

# Den Dauerlaeufer beenden, sonst haengt er bis zum naechsten Neustart am
# Ereignisstrom und haelt seine Sperrdatei.
#
# WIE EIN EIGENER PROZESS ERKANNT WIRD - GEAENDERT IN 0.9.23
#
# Bis 0.9.22 wurde die Befehlszeile aus /proc/<pid>/cmdline mit einem
# Zeichentausch zu EINER Zeichenkette gemacht und per Teilzeichenkette
# durchsucht. In WSL Ubuntu gemessen am 18.09.2026 mit dem Koeder
# "tail -f <botpfad>":
#
#     <OK> Bot-Lauf (PID 684972) beendet.
#
# Gemeint war der Bot, beendet wurde der Koeder.
# Quelle: Bestand-2026-09-18/klasse-F-nachmessung, Zeile 11b.
#
# Die Begruendung der argumentweisen Erkennung steht ausfuehrlich in
# postinstall.sh; die beiden Funktionen sind wortgleich und gehoeren
# zusammen geaendert.
# Rueckfall, falls das fuenfte Argument fehlt: ohne Wurzelverzeichnis waere
# der Botpfad unbrauchbar, und dann wuerde gar nichts mehr beendet - die
# Erkennung ueber die Sperrdatei allein gibt es seit 0.9.23 nicht mehr.
[ -n "$ARGV5" ] || ARGV5="$LBHOMEDIR"
[ -n "$ARGV3" ] || ARGV3="signalbot"
BOT="$ARGV5/bin/plugins/$ARGV3/sg_bot.php"
BOT_R=$(readlink -f "$BOT" 2>/dev/null)
[ -n "$BOT_R" ] || BOT_R="$BOT"
# Dieses Skript laeuft als ROOT, der Bot als loxberry - deshalb wird der
# Benutzer gemessen und nicht vom eigenen Prozess uebernommen.
BOT_UID=$(id -u loxberry 2>/dev/null)
[ -n "$BOT_UID" ] || BOT_UID=$(id -u)
SPERRE="/tmp/$ARGV3/bot.lock"

sg_ist_dienst() {
    [ -r "/proc/$1/cmdline" ] || return 1
    {
        IFS= read -r -d '' sg_a0 || return 1
        IFS= read -r -d '' sg_a1 || return 1
        case "${sg_a0##*/}" in
            php|php[0-9]|php[0-9].[0-9]|php[0-9].[0-9][0-9]) ;;
            *) return 1 ;;
        esac
        if [ "$sg_a1" != "$BOT" ]; then
            case "$sg_a1" in
                /*) sg_voll="$sg_a1" ;;
                *)  sg_voll="$(readlink -f "/proc/$1/cwd" 2>/dev/null)/$sg_a1" ;;
            esac
            [ "$(readlink -f "$sg_voll" 2>/dev/null)" = "$BOT_R" ] || return 1
        fi
        IFS= read -r -d '' sg_a2 && return 1
        return 0
    } < "/proc/$1/cmdline"
}

# Zwei Quellen - die Sperrdatei allein laesst einen Bot OHNE sie stehen. In
# WSL gemessen (Fall F8): nach dem Entfernen lief der Bot weiter und haengte
# bis zum naechsten Neustart am Ereignisstrom.
sg_dienste() {
    {
        for sg_d in /proc/[0-9]*; do
            sg_pid="${sg_d#/proc/}"
            sg_ist_dienst "$sg_pid" || continue
            [ "$(stat -c %u "$sg_d" 2>/dev/null)" = "$BOT_UID" ] || continue
            echo "$sg_pid"
        done
        if [ -f "$SPERRE" ]; then
            sg_p=$(head -c 12 "$SPERRE" 2>/dev/null | tr -dc '0-9')
            case "$sg_p" in
                ''|*[!0-9]*) ;;
                *) sg_ist_dienst "$sg_p" && echo "$sg_p" ;;
            esac
        fi
    } | sort -un
}

SG_ZIEL=$(sg_dienste)
if [ -n "$SG_ZIEL" ]; then
    SG_LISTE=$(printf '%s' "$SG_ZIEL" | tr '\n' ' ')
    kill $SG_ZIEL 2>/dev/null
    sg_i=0
    while [ $sg_i -lt 10 ]; do
        [ -n "$(sg_dienste)" ] || break
        sleep 1
        sg_i=$((sg_i + 1))
    done
    # Vor dem harten Signal wird NEU gesucht: eine Nummer kann zwischendurch
    # frei geworden und neu vergeben sein.
    SG_REST=$(sg_dienste)
    if [ -n "$SG_REST" ]; then
        kill -9 $SG_REST 2>/dev/null
        sleep 1
    fi
    SG_UEBRIG=$(sg_dienste)
    if [ -z "$SG_UEBRIG" ]; then
        echo "<OK> Bot-Lauf beendet (PID $SG_LISTE)."
    else
        echo "<WARNING> Ein Bot-Lauf laeuft weiter (PID $(printf '%s' "$SG_UEBRIG" | tr '\n' ' '))."
    fi
fi
rm -rf "/tmp/$ARGV3"

# Die Zweitschrift liegt NEBEN dem Plugin-Ordner, damit sie ein Update
# ueberlebt. Genau deshalb ueberlebt sie auch die Deinstallation - und darin
# stehen Zugriffstoken, PIN-Hash und alle erlaubten Rufnummern. Wer neben dem
# Ordner ablegt, raeumt hier selbst auf.
# Die native Bibliothek liegt neben dem Datenordner, damit sie Updates
# ueberlebt - also ueberlebt sie auch die Deinstallation. Hier weg damit.
if [ -n "$ARGV5" ] && [ -d "$ARGV5/data/plugins/$ARGV3.nativ" ]; then
    rm -rf "$ARGV5/data/plugins/$ARGV3.nativ"
    echo "<OK> Ordner mit der nativen Bibliothek entfernt."
fi

if [ -n "$ARGV5" ] && [ -f "$ARGV5/config/plugins/$ARGV3.backup.signalbot.json" ]; then
    rm -f "$ARGV5/config/plugins/$ARGV3.backup.signalbot.json"
    echo "<OK> Zweitschrift der Konfiguration entfernt (enthielt Token und Rufnummern)."
fi

# Die Marke aus preupgrade.sh, falls eine Aktualisierung abgebrochen ist.
# Sie liegt NEBEN dem Datenordner und ueberlebt deshalb auch das Entfernen
# des Plugins; eine liegengebliebene Marke wuerde nach einer Neuinstallation
# den Wecker bis zu einer Stunde aussperren.
if [ -n "$ARGV5" ] && [ -f "$ARGV5/data/plugins/$ARGV3.upgrade_laeuft" ]; then
    rm -f "$ARGV5/data/plugins/$ARGV3.upgrade_laeuft"
    echo "<OK> Marke der Aktualisierung entfernt."
fi

# Die Signal-Schluessel werden BEWUSST NICHT geloescht. Wer sie loescht,
# meldet das Zweitgeraet ab und muss neu verknuepfen - das soll niemand aus
# Versehen ausloesen.
echo "<INFO> signal-cli, die Signal-Schluessel und die Java-Laufzeit bleiben erhalten."
echo "<INFO> Wer auch die entfernen will:"
echo "<INFO>   sudo rm -rf /var/lib/signal-cli /opt/signal-cli-*"
echo "<INFO>   sudo rm -f /usr/local/bin/signal-cli"
echo "<INFO>   sudo userdel signalcli"
echo "<INFO>   sudo apt-get purge openjdk-25-jre-headless   (nur wenn nichts anderes Java braucht)"
echo "<INFO> Danach im Handy unter Signal - Gekoppelte Geraete das Geraet loeschen."
exit 0
